---
import Article from '@/layouts/Article.astro';
import { getCollection , render } from 'astro:content';
import { readTime, formatDate } from '@/lib/article-meta';

export async function getStaticPaths() {
  const entries = await getCollection('building-fr');
  return entries.map(entry => ({
    // Subfolders under the collection root are grouping-only; URL slug is
    // the file basename only. See docs/constraints.md "Content".
    params: { slug: entry.id.split('/').pop() },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  backHref="/fr/building"
  backLabel="Building"
  date={formatDate(entry.data.date, 'fr') ?? undefined}
  isoDate={entry.data.date ? entry.data.date.toISOString() : undefined}
  readTime={readTime(entry.body, 'fr')}
  lang="fr"
>
  <Content />
</Article>
