{
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "allow": [
      "Agent",
      "WebFetch",
      "WebSearch",
      "Bash"
    ]
  },
  "enabledPlugins": {
    "vercel-plugin@vercel": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bash /Users/ahmedomrane/Workspace/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ahmedomrane/Workspace/.claude/hooks/block-protected-push.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bash /Users/ahmedomrane/Workspace/.claude/hooks/auto-commit.sh"
          }
        ]
      }
    ]
  }
}
