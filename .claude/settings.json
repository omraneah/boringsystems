{
  "permissions": {
    "allow": [
      "Agent",
      "WebFetch",
      "WebSearch",
      "Bash",
      "Edit",
      "Write",
      "NotebookEdit",
      "Skill(*)",
      "mcp__claude_ai_Airtable__ping",
      "mcp__claude_ai_Airtable__list_bases",
      "mcp__claude_ai_Airtable__search_bases",
      "mcp__claude_ai_Airtable__list_tables_for_base",
      "mcp__claude_ai_Airtable__get_table_schema",
      "mcp__claude_ai_Airtable__list_records_for_table",
      "mcp__claude_ai_Airtable__list_pages_for_base",
      "mcp__claude_ai_Airtable__list_records_for_page",
      "mcp__claude_ai_Airtable__get_record_for_page",
      "mcp__claude_ai_Airtable__search_records",
      "mcp__claude_ai_Airtable__list_record_comments",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__list_issue_labels",
      "mcp__claude_ai_Linear__save_comment",
      "mcp__claude_ai_Linear__save_issue"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agent-hooks/block-protected-push.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agent-hooks/enforce-feature-branch.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agent-hooks/parallel-by-default-reminder.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agent-hooks/brevity-reminder.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agent-hooks/auto-commit.sh\"",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agent-hooks/post-edit-typecheck.sh\"",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gtm-nudge.sh\"",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
