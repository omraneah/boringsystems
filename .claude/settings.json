{
  "permissions": {
    "allow": [
      "Agent",
      "WebFetch",
      "WebSearch",
      "Bash"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ahmedomrane/Workspace/.claude/hooks/session-start.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "find /Users/ahmedomrane/Workspace/tmp -mindepth 1 -not -name '.gitkeep' -not -name 'README.md' -delete",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ahmedomrane/Workspace/.claude/hooks/block-protected-push.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ahmedomrane/Workspace/.claude/hooks/parallel-by-default-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ahmedomrane/Workspace/.claude/hooks/auto-commit.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "bash /Users/ahmedomrane/Workspace/.claude/hooks/post-edit-typecheck.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "bash /Users/ahmedomrane/Workspace/.claude/hooks/gtm-nudge.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
